{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "poui-invoice-report": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "exceljs",
              "file-saver",
              "@totvs/twebchannel-js"
            ],
            "outputPath": "dist/poui-invoice-report",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@po-ui/style/css/po-theme-default.min.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          },
          "configurations": {
            "protheus": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.protheus.ts"
                }
              ]
            },
            "ghpages": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.ghpages.ts"
                }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "protheus"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "protheus": {
              "buildTarget": "poui-invoice-report:build:protheus"
            },
            "ghpages": {
              "buildTarget": "poui-invoice-report:build:ghpages"
            }
          },
          "defaultConfiguration": "protheus"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@po-ui/style/css/po-theme-default.min.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy",
          "configurations": {
            "ghpages": {
              "buildTarget": "poui-invoice-report:build:ghpages",
              "baseHref": "/poui-invoice-report/"
            }
          },
          "defaultConfiguration": "ghpages"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
